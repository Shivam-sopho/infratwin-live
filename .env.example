# Meta Model API key — https://dev.meta.ai (Bearer auth, base https://api.meta.ai/v1)
MODEL_API_KEY=

# Telemetry simulator
SIM_TICK_HZ=2
# Auto-inject the scripted Pier 4 anomaly N seconds after backend start (0 = off; use the UI button instead)
SIM_AUTO_ANOMALY_S=0

# Cognitive Twin: auto-triage critical alerts with Muse Spark (needs MODEL_API_KEY)
TRIAGE_AUTO=true

# Open-weight Muse models via any OpenAI-compatible endpoint (vLLM on Modal, OpenRouter, Together, Fireworks)
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
SPARK_OPEN_MODEL=
