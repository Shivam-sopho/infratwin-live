# Meta Model API key — https://dev.meta.ai (Bearer auth, base https://api.meta.ai/v1)
MODEL_API_KEY=

# Telemetry simulator
SIM_TICK_HZ=2
# Auto-inject the scripted Pier 4 anomaly N seconds after backend start (0 = off; use the UI button instead)
SIM_AUTO_ANOMALY_S=0

# Cognitive Twin: auto-triage critical alerts with Muse Spark (needs MODEL_API_KEY)
TRIAGE_AUTO=true

# Open-weight Muse models via any OpenAI-compatible endpoint (vLLM on Modal, OpenRouter, Together, Fireworks)
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
GLIMMER_MODEL=
SPARK_OPEN_BASE_URL=
SPARK_OPEN_API_KEY=
SPARK_OPEN_MODEL=

# SAM 3D endpoints from `modal deploy modal_workers/sam3d_service.py` (proxy auth: Modal workspace proxy token)
SAM3D_OBJECTS_URL=
SAM3D_BODY_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Production
# Shared access token: when set, the UI asks for it and every API call / the telemetry socket require it.
APP_ACCESS_TOKEN=
COOKIE_SECURE=false
# Estimated daily spend cap (USD) for paid model calls; calls above it are refused with 429.
MAX_DAILY_USD=5

# Real monitoring data: KW51 tracked modes (download trackedmodes.zip from Zenodo 10.5281/zenodo.3745914,
# CC BY-NC-SA 4.0). The KW51 asset appears only when this file exists.
KW51_PATH=
KW51_HOURS_PER_S=24
